# Copy to .env and fill in.

# mock (default): the official dataset, no internet needed.
# live: Phase 2 real data (CinemaPlus schedule, DummyJSON products; Aviasales fares if the token below is set).
SUPERCHAT_DATA=live

# Free Aviasales Data API token: https://www.travelpayouts.com (Profile -> API token).
# Without it, flights stay on the mock dataset even in live mode.
TRAVELPAYOUTS_TOKEN=
